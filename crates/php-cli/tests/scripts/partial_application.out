Closure [ <user> static function {closure:pfa:%s:42} ] {
  @@ %s 42 - 42

  - Bound Variables [1] {
      Variable #0 [ $a ]
  }

  - Parameters [2] {
    Parameter #0 [ <required> $b ]
    Parameter #1 [ <optional> $c = 'c' ]
  }
}
