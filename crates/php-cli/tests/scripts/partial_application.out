Closure [ <user> static function {closure:pfa:%s:34} ] {
  @@ %s 34 - 34

  - Bound Variables [1] {
      Variable #0 [ $a ]
  }

  - Parameters [2] {
    Parameter #0 [ <required> $c ]
    Parameter #1 [ <required> $b ]
  }
}
