--- string
POST /echo
accept: */*
content-length: 7
content-type: application/x-www-form-urlencoded

a=b&c=d--- postfields alone
POST /echo
accept: */*
content-length: 3
content-type: application/x-www-form-urlencoded

x=1--- empty
POST /echo
accept: */*
content-length: 0
content-type: application/x-www-form-urlencoded

--- custom content type
POST /echo
accept: */*
content-length: 7
content-type: application/json

{"a":1}--- array
POST /echo
accept: */*
content-length: 551
content-type: multipart/form-data; boundary=BOUNDARY

--BOUNDARY
Content-Disposition: form-data; name="name"

v1
--BOUNDARY
Content-Disposition: form-data; name="list"

a
--BOUNDARY
Content-Disposition: form-data; name="list"

b
--BOUNDARY
Content-Disposition: form-data; name="5"

five
--BOUNDARY
Content-Disposition: form-data; name="n"

42
--BOUNDARY--
