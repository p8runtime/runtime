# p8's instruction definitions: the opcodes of the executed form (`Insn`).
#
# Read by p8-vmgen (crates/p8-vmgen/src/lib.rs, which documents the
# format) from p8-bytecode's build.rs, which writes the `Op` enum, the kind
# constants and the encoders lowering picks a handler with, and from
# p8-interp's build.rs, which writes the loop's dispatch arms. Each `op`
# is written once, its handler in crates/p8-interp/src/vmops.rs with its
# operand kinds as `const` parameters; every live combination of kinds is
# one opcode, `P8_<OP>_<KINDS>`, with the tests of the kinds folded away.
# A `hand` opcode's arm is written by hand in crates/p8-interp/src/fast.rs.
# `native=<template>` (an `op`'s or a `hand`'s): the native backend's
# template for the opcode, in crates/p8-native-gen/src/tpl.rs, read from
# p8-native-gen's build.rs (#385). An opcode without one is never native:
# a function using it runs on the interpreter.
#
# Operands are listed in the order lowering passes them and the handler
# takes them. Registers: TMP, CV, REG (either). Literals of the closure's
# constants: K (any), KINT, KSTR. IMM / IMM16: raw immediates. THIS: the
# frame's `$this`. Anything else is a flag: USED/UNUSED (the result is
# read / freed by the next instruction, which is then skipped), COPY/TAKE
# (the value operand is copied / moved out of its temporary), T/F (branch
# when the condition holds / does not), LT.. (the comparison).

# ---- generated --------------------------------------------------------

/// `a = b` (`Move`), `a = K` (`LoadConst`): a copy into a temporary.
op MOVE mov cold=cold_run native=mov dst=REG src=REG|K
/// `$var = b`, `$var = K` (`Assign`, `AssignC`): through a reference the variable holds.
op ASSIGN assign cold=cold_run native=assign var=REG src=REG|K
/// `$var = tmp`, the temporary read for the last time (`AssignTake`): moved, not copied.
op ASSIGN_TAKE assign_take cold=cold_run var=REG src=REG
/// Release a temporary (`Free`).
op FREE free cold=cold_run native=free reg=REG
/// `a = $this` (`This`).
op THIS this cold=cold_run dst=REG
/// Jump to `target` when `cond` is true (T, `JumpIf`) / false (F, `JumpIfNot`).
op JUMP_COND jump_cond cold=cold_run native=jump_cond when=T|F cond=REG target=IMM
/// Compare `a` with `b` (a register, or a literal on the right), jump to
/// `target` when the test is T / F (`JumpLt` .. `JumpNotIdentical`).
/// GT and GE are a literal on the left (`K < a` is `a > K`).
op JUMP_CMP jump_cmp cold=cold_run native=jump_cmp cmp=LT|LE|GT|GE|EQ|ID when=T|F a=REG b=REG|K target=IMM
drop cmp=GT b=REG
drop cmp=GE b=REG
/// `dst = arr[key]` (`FetchDim`): a read (R: a missing key warns), or a
/// quiet one (IS: `??`, a missing key is null; EMPTY: empty()'s last
/// dimension, which the handler reads as IS). The rest (an ArrayAccess
/// object, a conversion, a warning) runs out of line on the operands
/// (`fetch_dim_out`; `step` runs the same code).
op FETCH_DIM fetch_dim out=fetch_dim_out::<S> mode=R|IS|EMPTY dst=REG arr=REG key=REG|KINT|KSTR
/// `dst = isset(var[key])`, one dimension (`IssetDim`). The rest (an
/// ArrayAccess object, a string's offset) runs out of line on the operands
/// (`isset_dim_out`; `step` runs the same code).
op ISSET_DIM isset_dim out=isset_dim_out::<S> dst=REG var=REG key=REG|KINT|KSTR
/// `var[key] = val`, one dimension (`AssignDim`); `dst` = the value when USED.
/// The rest (an ArrayAccess object, a string offset, a conversion's
/// warning) runs out of line on the operands (`assign_dim_out`; `step`
/// runs the same code).
op ASSIGN_DIM assign_dim out=assign_dim_out::<S> var=REG key=REG|KINT|KSTR val=REG|K res=USED|UNUSED dst=REG
drop key=KINT val=K
drop key=KSTR val=K
/// `var[] = val` (`AssignDim` appending); `dst` = the value when USED.
/// The rest runs out of line on the operands (`append_dim_out`).
op APPEND_DIM append_dim out=append_dim_out::<S> var=REG val=REG|K res=USED|UNUSED dst=REG
/// `dst = obj->(property site)`, `obj` a register or `$this` (`FetchProp`):
/// a read (R), or a quiet one (IS: `??`, `?->`). What the entry does not
/// answer runs out of line on the operands (`fetch_prop_out`: a hook,
/// `__get`, a lazy object, an unset or undeclared property, the entry
/// filled; `step` runs the same code).
op FETCH_PROP fetch_prop out=fetch_prop_out::<S> mode=R|IS dst=REG obj=REG|THIS site=IMM16
/// `obj->(property site) = val` (`AssignProp`); `dst` = the value when USED.
/// What the entry does not answer runs out of line on the operands
/// (`assign_prop_out`: a hook, `__set`, a lazy object, a dynamic
/// property, a typed one's coercion; `step` runs the same code).
op ASSIGN_PROP assign_prop out=assign_prop_out::<S> obj=REG|THIS val=REG|K mode=COPY|TAKE res=USED|UNUSED dst=REG site=IMM16
drop val=K mode=TAKE
/// `return src` (`Return`): to the calling frame, or out of this run of
/// the loop when the frame is its bottom one (a callback a builtin
/// called). The script's end and a generator's return are cold (`step`).
op RETURN ret cold=step native=ret src=TMP|CV|K
/// `dst = src instanceof C` (`InstanceOf`), C a class the code names
/// (NAMED: `C`, and `self`/`parent` in a class), the called class
/// (STATIC: `static`) or the class using a trait (SCOPE: `self` in one);
/// OTHER (a class in a register, `parent` in a trait) and what the arm
/// does not answer run out of line on the operands (`instance_of_out`;
/// `step` runs the same code).
op INSTANCEOF instance_of out=instance_of_out cls=NAMED|STATIC|SCOPE|OTHER dst=REG src=REG class=IMM16
/// `dst = C::NAME` (`ClassConst`): the value the name's cache entry
/// (`site`, the name's constant) holds for the class, C as INSTANCEOF's;
/// a miss (a first read) runs out of line on the operands
/// (`class_const_out`: the class resolved, a pending constant computed,
/// the entry filled; `step` runs the same code).
op CLASS_CONST class_const out=class_const_out cls=NAMED|STATIC|SCOPE dst=REG class=IMM16 site=IMM16
/// `dst = C::$name` (`FetchStaticProp`): the property's cell the name's
/// cache entry (`site`, the name's constant) holds for the class and the
/// code's scope, C as INSTANCEOF's; a miss runs out of line on the
/// operands (`fetch_static_prop_out`, which fills the entry; `step` runs
/// the same code).
op FETCH_STATIC_PROP fetch_static_prop out=fetch_static_prop_out cls=NAMED|STATIC|SCOPE dst=REG class=IMM16 site=IMM16
/// `C::$name = val` (`AssignStaticProp`): stored in the property's cell
/// FETCH_STATIC_PROP's cache entry holds (through a reference the cell
/// holds), `dst` = the value; C as INSTANCEOF's. A miss, an undefined
/// value run out of line on the operands (`assign_static_prop_out`;
/// `step` runs the same code).
op ASSIGN_STATIC_PROP assign_static_prop out=assign_static_prop_out::<S> cls=NAMED|STATIC|SCOPE val=REG|K dst=REG class=IMM16 site=IMM16

# ---- written by hand ---------------------------------------------------

/// Not run by the loop: `step` runs the `Instr` at this pc.
hand Slow
hand VerifyArgs native=verify_args
/// a: the value returned; b: 1 when none was (`return;`, the end), for
/// the TypeError's text. A value the quick test does not pass runs out of
/// line (`verify_return_ops`: a coercion, a Stringable, the error)
hand VerifyReturn native=verify_return
/// a = intrinsic (imm >> 16, `INTRINSICS`) of the c arguments at b; call site imm & 0xffff
hand Intrinsic
/// pass b's variable c as argument imm >> 16 of method site imm & 0xffff on the object in a
hand SendVarMethod
/// pc = imm
hand Jump native=jump
/// a = b (cmp imm, `cmp`) c
hand Compare
hand IncVar native=inc_dec_var
hand DecVar native=inc_dec_var
/// step a, test against b, jump to imm
hand IncJumpLt native=step_jump
hand IncJumpLe native=step_jump
hand DecJumpGt native=step_jump
hand DecJumpGe native=step_jump
/// a = b (op imm, `binop`) c
hand Binary
hand Add native=arith
hand Sub native=arith
hand Mul native=arith
/// a = the c registers from b concatenated
hand ConcatN
/// a[b] (op imm >> 8) = c; imm & 0xff = the result register
hand AssignDimOp
/// next of iterator a: value to b (and key to c for IterNextKey), or jump to imm
hand IterNext
hand IterNextKey
/// a (op imm) = b
hand AssignOp native=assign_op
/// a's step (imm: INC, POST) into b
hand IncDec
hand LoadNull native=load_null
/// a = !b
hand Not
hand ToBool
/// a = isset(b)
hand IssetVar
/// a ?? : b = a and jump to imm when set
hand JumpIfSet
/// a = [] with room for imm
hand NewArray
/// a[] = b (imm: TAKE)
hand ArrayPush
/// a[b] = c (imm: TAKE)
hand ArraySet
/// a = constant of site imm
hand FetchConst
/// foreach over a: the array (b, b + 1 = it and its position 0), or to
/// imm when it is empty
hand IterInit
/// argument n (imm >> 16) of call site imm & 0xffff: a = b, when the
/// function takes it by value
hand SendVar
/// call site imm with the b arguments at a, result to c
hand Call native=call
/// `f(x0, .., xn-1)`, x the b registers from a (one for any register,
/// several when they are consecutive), whose `Instr`s are the b `Move`s
/// into the call's argument registers (from imm >> 16) and the `Call`
/// (site imm & 0xffff, result to c) that follow: a frameless builtin
/// call reads its arguments where they are, and pc goes past the call.
/// Anything else runs the first Move (and the code after it) as it is.
hand CallRegs native=call_regs
/// a = b->(method site imm & 0xffff) with the imm >> 16 arguments at c;
/// sends no variables itself (`vars` is NO_VARS)
hand MethodCall
/// MethodCall with variables it sends itself (`vars`, read from the
/// `Instr` at this pc): the same operands
hand MethodCallVars
/// a = a new object of class reference imm (its constructor not run)
hand New
/// the constructor of the object in a, with the c arguments at b
hand Construct
/// a = class reference imm >> 16's method (site imm & 0xffff) with
/// the c arguments at b; sends no variables itself (`vars` is NO_VARS)
hand StaticCall
/// StaticCall with variables it sends itself (`vars`, read from the
/// `Instr` at this pc): the same operands
hand StaticCallVars
hand ReturnNull native=ret_null
/// a = a closure of lambda imm & 0xffff (imm >> 16: static)
hand MakeClosure
/// variadic parameter a = its argument (if passed) and the extra ones
hand CollectVariadic
/// the array in a gets b's elements (`[...$b]`)
hand ArrayUnpack
/// the constructor of the object in a, with b's values as its arguments
/// (`new C(...$b)`)
hand ConstructSpread
/// pass b's variable as argument c of `C::m()` (method site imm & 0xffff,
/// class reference imm >> 16) into register a
hand SendVarStatic
/// `global $name` in a function: a = a reference to the global named by
/// constant imm (its cache entry, `Closure::globals`)
hand BindGlobal
/// a[k0]..[kn-1] = c (or `..[] = c`, PATH_APPEND), the n keys the
/// registers from b (1 to PATH_KEYS); imm: n, the result register (bits
/// 8..16), PATH_APPEND, PATH_UNUSED
hand AssignDimPath
/// a->(property site imm & 0xffff)[k0]..[kn-1] = c (or `..[] = c`), the
/// n keys the registers from b (0 to PATH_KEYS); imm: the result register
/// (bits 16..24), n (bits 24..28), PROP_PATH_THIS (`$this`, not a),
/// PATH_APPEND, PATH_UNUSED
hand AssignPropDim
/// unset(a[k0]..[kn-1]), the n keys the registers from b (1 to PATH_KEYS)
hand UnsetDim
/// a[k0]..[kn-1]++ (and --, ++a[..]), the n keys the registers from b (1
/// to PATH_KEYS), the value of the expression into c; imm: n, INC, POST
/// (bits 8 and 9)
hand DimIncDec
/// a = (cast imm, `CastKind` as a number) b
hand Cast
/// a->(property site imm & 0xffff)++ (and --), the value of the expression
/// into b; imm: INC and POST (bits 16 and 17), PROP_PATH_THIS (`$this`,
/// not a)
hand PropIncDec
/// a = whether argument c of method site imm on the object in b is passed
/// by reference
hand MethodArgByRef
/// a = a reference to the object in b's property (site imm), made one
hand PropRef
/// a = whether argument c of `C::m()` (method site imm & 0xffff, class
/// reference imm >> 16) is passed by reference
hand StaticArgByRef
/// parameter a was passed (not a hole a named argument left): pc = imm,
/// past its default's code
hand ArgDefault
/// a = whether argument c of the function call site imm is passed by
/// reference
hand FuncArgByRef
/// `static $a`: a = a reference to static variable b | c << 8 of the
/// running code; pc = imm (past its initializer) when it was made before
hand StaticVar
/// `foreach ($a as &$v)` of the array in a (made a reference): iterator b
/// (its position 0, the reference at b + 1), or pc = imm when it is empty
hand IterInitRef
/// A `foreach (.. as &$v)` step (iterator a, its position; the state at
/// a + 1): b = a reference to the next element, c = its key when imm has
/// ITER_KEY, else pc = imm & !ITER_KEY (past the loop)
hand IterNextRef
/// a = b[key] for a list() destructuring, the key register c with
/// LIST_KEY_REG, else constant imm
hand FetchList
/// a = b(the imm & 0xff arguments at c), the variables of `arg_vars`
/// entry imm >> 8 (NO_VARS: none) sent as the callable takes them
hand CallValue
/// a->(property site imm & 0xffff) (op imm >> 16 & 15) = b (constant b
/// with PROP_OP_K), the result into c; PROP_PATH_THIS (`$this`, not a)
hand AssignPropOp
/// `$a = &$b`
hand BindRef
/// `unset($a)`
hand UnsetVar
/// a = (object) b
hand ToObject
/// a = whether the callable in b takes argument imm by reference
/// (u16::MAX: the named one whose name is in c)
hand CallableArgByRef
/// a = $$b (imm: bit 0 quiet, bit 1 a global's)
hand VarGet
/// a = a reference to $$b (imm 1: a global's), out of line (`var_ref_ops`)
hand VarRef
/// unset($a->{name}), the name operand in imm (a constant or a register),
/// out of line (`unset_prop_ops`)
hand UnsetProp
/// a = a reference to the superglobal named b
hand AutoGlobal
/// `[&$b]`: a reference to b appended to the array literal in a
hand ArrayPushRef
/// a = `C::$name op= b` (class reference c, the name constant imm & 0x3fff,
/// the operator imm >> 14 & 15, constant b with STATIC_OP_K)
hand AssignStaticPropOp
/// declaration imm of the running code declared (a class)
hand DeclareClass
/// lambda imm of the running code declared (a function)
hand DeclareFunction
/// a = `include` b (or constant imm >> 8 with SRC_K; the kind in imm & 3)
hand Include
/// a = b(...) (or a constant, as Include's)
hand FromCallable
/// a = `yield` b (or a constant), with key c (imm: YIELD_*)
hand Yield
/// a = `yield from` b (or a constant)
hand YieldFrom
/// `$a = &$b[c]..` (imm: the key count, REF_APPEND, REF_KEY_K), an
/// element passed by reference too
hand RefDim
/// `$b[c].. = &$a` (imm as RefDim's)
hand DimSetRef
/// `$a = &C::$name` (class reference imm, the name in register b)
hand StaticRef
/// a = b->{c} (`$this` with PROP_PATH_THIS): the name in a register
hand FetchPropDyn
/// a->{c} = b (`$this` with PROP_PATH_THIS; TAKE; constant b with
/// PROP_OP_K), the value into register imm >> 8
hand AssignPropDyn
/// a = isset(b->(property site imm)), or isset(b->{c}) with ISSET_PROP_DYN
hand IssetProp
/// a = isset(b[c][c + 1]..), imm keys (two or more: ISSET_DIM is one)
hand IssetDimPath
/// a = b(...c): the call with the array's values as its arguments
hand CallSpread
/// `@`: a = the error level, then the level narrowed to the fatal kinds
hand Silence
/// the end of `@`: the level saved in a back, unless the silenced code
/// changed it
hand Unsilence
/// a = -b
hand Neg
/// a = ~b: an int's inline; anything else (a float's, a string's, the
/// TypeError) out of line (`bit_not_ops`)
hand BitNot
/// closure a captures variable b (`use ($b)`; imm: CAPTURE_REF `use (&$b)`,
/// CAPTURE_QUIET no warning for an undefined one)
hand Capture
/// a = $b::class (`ClassConst` of class reference imm, a class in
/// register b, the name `class`): an object's class name; a string naming
/// a class (autoloaded), the error of anything else, out of line
hand ClassName
/// `echo` of the operand in imm (a register or a constant), out of line
/// (`echo_ops`)
hand Echo
/// a = `clone` of the operand in imm, out of line (`clone_ops`)
hand Clone
/// `throw` of the operand in imm, out of line (`throw_ops`)
hand Throw
/// a catch's test: pc = imm when the exception in a is an instance of
/// class reference b | c << 8, out of line (`catch_if_ops`)
hand CatchIf
/// a = isset(class reference imm's static property named by register b),
/// out of line (`isset_static_ops`)
hand IssetStatic

# The constant forms: the same operations with one operand a literal,
# read in place from the closure's constants (`Function::consts`), as
# PHP's handlers read a CONST operand. `K` below is that constant.
/// a = b (cmp imm & 15, `cmp`) K (imm >> 8)
hand CompareC
/// a = b op K (imm)
hand AddC native=arith
hand SubC native=arith
hand MulC native=arith
/// a = b (op imm & 15, `binop`) K (imm >> 8), or K op b with CONST_LEFT
hand BinaryC
/// a (op imm & 15) = K (imm >> 8)
hand AssignOpC native=assign_op
/// step a, test against K (`wide`), jump to imm
hand IncJumpLtC native=step_jump
hand IncJumpLeC native=step_jump
hand DecJumpGtC native=step_jump
hand DecJumpGeC native=step_jump
/// a[] = K (imm)
hand ArrayPushC
/// a[key] = val with the key, the value or both constants (KEY_CONST,
/// VAL_CONST; the constants in imm bits 0..14 and 14..28; TAKE as
/// ArraySet's)
hand ArraySetC
